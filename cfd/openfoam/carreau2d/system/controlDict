FoamFile { version 2.0; format ascii; class dictionary; object controlDict; }
application     simpleFoam;
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         2000;
deltaT          1;
writeControl    timeStep;
writeInterval   500;
purgeWrite      2;
writeFormat     ascii;
writePrecision  6;
timeFormat      general;
timePrecision   6;

functions
{
    sample
    {
        type                sets;
        libs                ("libsampling.so");
        writeControl        timeStep;
        writeInterval       500;
        interpolationScheme cellPoint;
        setFormat           raw;
        sets
        {
            lineX9 { type uniform; axis y; start (4.5e-4 5e-8 2.5e-5); end (4.5e-4 4.995e-5 2.5e-5); nPoints 40; }
        }
        fields (U p);
    }
}
