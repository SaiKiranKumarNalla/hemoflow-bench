FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}

application     simpleFoam;
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         5000;
deltaT          1;
writeControl    timeStep;
writeInterval   1000;
purgeWrite      2;
writeFormat     ascii;
writePrecision  8;
writeCompression off;
timeFormat      general;
timePrecision   6;
runTimeModifiable true;

functions
{
    inletPressure
    {
        type            surfaceFieldValue;
        libs            (fieldFunctionObjects);
        executeControl  timeStep;
        executeInterval 1;
        writeControl    timeStep;
        writeInterval   1;
        writeFields     false;
        log             false;
        regionType      patch;
        name            inlet;
        operation       areaAverage;
        fields          (p);
    }

    qoiProbes
    {
        type            probes;
        libs            ("libsampling.so");
        executeControl  timeStep;
        executeInterval 1;
        writeControl    timeStep;
        writeInterval   1;
        fields          (U);
        probeLocations
        (
            (7 10.5 0.5)
        );
    }

    writeCellCentres
    {
        type            writeCellCentres;
        libs            (fieldFunctionObjects);
        writeControl    onEnd;
    }

    writeCellVolumes
    {
        type            writeCellVolumes;
        libs            (fieldFunctionObjects);
        writeControl    onEnd;
    }

    gradU
    {
        type            grad;
        libs            (fieldFunctionObjects);
        field           U;
        writeControl    onEnd;
    }

    sample
    {
        type                sets;
        libs                ("libsampling.so");
        writeControl        onEnd;
        interpolationScheme cellPoint;
        setFormat           raw;
        fields              (U p);
        sets
        {
            inletProfile
            {
                type    uniform;
                axis    y;
                start   (-0.5 0.02 0.5);
                end     (-0.5 0.98 0.5);
                nPoints 80;
            }
            bend1Apex
            {
                type    uniform;
                axis    x;
                start   (2.02 3 0.5);
                end     (2.98 3 0.5);
                nPoints 80;
            }
            outletProfile
            {
                type    uniform;
                axis    y;
                start   (7 10.02 0.5);
                end     (7 10.98 0.5);
                nPoints 80;
            }
        }
    }
}
