FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}

application     simpleFoam;
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         5000;
deltaT          1;
writeControl    timeStep;
writeInterval   1000;
purgeWrite      2;
writeFormat     ascii;
writePrecision  8;
writeCompression off;
timeFormat      general;
timePrecision   6;
runTimeModifiable true;

functions
{
    inletPressure
    {
        type            surfaceFieldValue;
        libs            (fieldFunctionObjects);
        executeControl  timeStep;
        executeInterval 1;
        writeControl    timeStep;
        writeInterval   1;
        writeFields     false;
        log             false;
        regionType      patch;
        name            inlet;
        operation       areaAverage;
        fields          (p);
    }

    qoiProbes
    {
        type            probes;
        libs            ("libsampling.so");
        executeControl  timeStep;
        executeInterval 1;
        writeControl    timeStep;
        writeInterval   1;
        fields          (U);
        probeLocations
        (
            (9.242640687 5.035533906 0.5)
            (9.242640687 -4.035533906 0.5)
        );
    }

    writeCellCentres
    {
        type            writeCellCentres;
        libs            (fieldFunctionObjects);
        writeControl    onEnd;
    }

    writeCellVolumes
    {
        type            writeCellVolumes;
        libs            (fieldFunctionObjects);
        writeControl    onEnd;
    }

    gradU
    {
        type            grad;
        libs            (fieldFunctionObjects);
        field           U;
        writeControl    onEnd;
    }

    sample
    {
        type                sets;
        libs                ("libsampling.so");
        writeControl        onEnd;
        interpolationScheme cellPoint;
        setFormat           raw;
        fields              (U p);
        sets
        {
            inletProfile
            {
                type    uniform;
                axis    y;
                start   (-0.5 0.02 0.5);
                end     (-0.5 0.98 0.5);
                nPoints 80;
            }
            expansionMid
            {
                type    uniform;
                axis    y;
                start   (2.25 -0.48 0.5);
                end     (2.25 1.48 0.5);
                nPoints 100;
            }
            nearWallExpansion
            {
                type    uniform;
                axis    x;
                start   (0.02 -0.48 0.5);
                end     (4.48 -0.48 0.5);
                nPoints 120;
            }
            daughter1Mid
            {
                type    uniform;
                axis    distance;
                start   (9.582051942 4.696122651 0.5);
                end     (8.903229432 5.374945161 0.5);
                nPoints 80;
            }
            daughter2Mid
            {
                type    uniform;
                axis    distance;
                start   (8.903229432 -4.374945161 0.5);
                end     (9.582051942 -3.696122651 0.5);
                nPoints 80;
            }
        }
    }
}
